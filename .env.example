# Template for .env.local and .env.sepolia. Copy, then fill in:
#   cp .env.example .env.local
# The copies are git-ignored: RPC URLs from Alchemy/Infura embed an API key.
# scripts/deploy.py writes CONTRACT_ADDRESS and DEPLOY_BLOCK after deploying.

# Local Anvil (scripts/start_chain.sh)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
DEPLOY_BLOCK=0
EXPLORER_URL=

# Off-chain object store shared by every GUI window (default: storage/ in the project root)
# STORAGE_DIR=storage

# Sepolia: use these values in .env.sepolia instead
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# EXPLORER_URL=https://sepolia.etherscan.io

# Only needed for `forge verify-contract` on Sepolia
# ETHERSCAN_API_KEY=
